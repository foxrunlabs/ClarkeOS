#===============================================================================
# DISPLAY
#===============================================================================

display_library: sdl
config_interface: textconfig


#===============================================================================
# IMAGE FILES
#===============================================================================

romimage: file="/usr/local/share/bochs/BIOS-bochs-latest"
vgaromimage: file="/usr/local/share/bochs/VGABIOS-lgpl-latest"


#===============================================================================
# COMPUTER
#===============================================================================

cpu: count=1, ips=1000000, reset_on_triple_fault=1
megs: 4

vga: extension=vbe
vga_update_interval: 40000

#floppya: 1_44="grubboot.img", status=inserted
floppy_bootsig_check: disabled=0

ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
ata1: enabled=1, ioaddr1=0x170, ioaddr2=0x370, irq=15
ata2: enabled=0
ata3: enabled=0

ata0-master: type=disk, path="clarkeos.img", mode=flat, cylinders=65, heads=16, spt=63

boot: disk, floppy

clock: sync=none, time0=local

com1: enabled=0
com2: enabled=0
com3: enabled=0
com4: enabled=0

parport1: enabled=0
parport2: enabled=0

i440fxsupport: enabled=1


#===============================================================================
# PERIPHERALS
#===============================================================================

keyboard_type: mf
keyboard_serial_delay: 250
keyboard_paste_delay: 100000
keyboard_mapping: enabled=0, map=

mouse: enabled=0, type=ps2

sb16: enabled=0

ne2k: enabled=0

usb_uhci: enabled=0

pnic: enabled=0


#===============================================================================
# MISCELLANEOUS
#===============================================================================

private_colormap: enabled=0
user_shortcut: keys=none
text_snapshot_check: enabled=0
magic_break: enabled=1


#===============================================================================
# LOGGING
#===============================================================================

log: ./bochs.out
debugger_log: -
logprefix: %t-%e-%d
panic: action=ask
error: action=report
info: action=report
debug: action=ignore
pass: action=fatal

